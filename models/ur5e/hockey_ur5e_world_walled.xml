<mujoco model="hockey_ur5e_world_walled">
  <!-- Base environment: UR5e robot, table surface, lighting, cameras, base contacts -->
  <include file="hockey_ur5e_base.xml"/>

  <!-- Puck -->
  <include file="hockey_puck.xml"/>

  <!-- Solid Back Rebound Wall -->
  <include file="back_wall.xml"/>

  <!-- Lateral Side Rebound Walls -->
  <include file="side_walls.xml"/>

  <contact>
    <!-- Frictionless, crisp elastic paddle strikes -->
    <pair geom1="paddle_geom" geom2="puck_geom" condim="1" friction="0 0 0 0 0" solref="-50000 0" solimp="0.99 0.99 0.001"/>
  </contact>
</mujoco>

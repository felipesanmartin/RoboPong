<mujoco model="back_wall">
  <worldbody>
    <!-- Solid Front/Opponent Rebound Wall at +X = 2.0 m -->
    <geom name="front_wall" type="box" pos="2.0 0.0 0.10" size="0.05 0.95 0.10" material="wall_mat"/>
  </worldbody>

  <contact>
    <!-- Frictionless, perfectly elastic rebound with front wall -->
    <pair geom1="front_wall" geom2="puck_geom" condim="1" friction="0 0 0 0 0" solref="-50000 0" solimp="0.99 0.99 0.001"/>
  </contact>
</mujoco>

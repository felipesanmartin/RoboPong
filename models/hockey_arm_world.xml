<mujoco model="hockey_arm_world">
  <compiler angle="radian" coordinate="local"/>

  <option timestep="0.001" gravity="0 0 -9.81" integrator="implicitfast" iterations="50" tolerance="1e-8">
    <flag contact="enable" energy="enable"/>
  </option>

  <default>
    <!-- Frictionless, perfectly elastic defaults for air hockey simulation -->
    <geom condim="3" friction="0.0 0.0 0.0" solref="-500000 0" solimp="0.999 0.999 0.0001"/>
    <joint damping="0.0" armature="0.0"/>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.4 0.6 0.8" rgb2="0.1 0.15 0.25" width="512" height="512"/>
    <texture name="grid" type="2d" builtin="checker" width="512" height="512" rgb1="0.88 0.94 0.98" rgb2="0.80 0.90 0.96"/>
    <material name="table_mat" texture="grid" texrepeat="6 4" reflectance="0.2"/>
    <material name="wall_mat" rgba="0.2 0.25 0.35 1.0" reflectance="0.3"/>
    <material name="paddle_mat" rgba="0.0 0.7 0.9 1.0" reflectance="0.4"/>
    <material name="puck_mat" rgba="0.9 0.1 0.1 1.0" reflectance="0.5"/>
    <material name="base_mat" rgba="0.2 0.22 0.25 1.0"/>
    <material name="arm1_mat" rgba="0.35 0.40 0.45 1.0" reflectance="0.4"/>
    <material name="arm2_mat" rgba="0.65 0.70 0.75 1.0" reflectance="0.5"/>
  </asset>

  <worldbody>
    <!-- Directional Light -->
    <light directional="true" diffuse="0.8 0.8 0.8" specular="0.3 0.3 0.3" pos="0 0 5" dir="0 0 -1" castshadow="true"/>

    <!-- Cameras -->
    <camera name="top_down" pos="0 0 5.5" xyaxes="0 1 0 -1 0 0"/>
    <camera name="behind_robot" pos="-4.0 0 2.5" xyaxes="0 1 0 -0.5 0 -0.866"/>

    <!-- Frictionless Air Hockey Table Surface -->
    <geom name="table_surface" type="plane" pos="0 0 0" size="3.0 2.0 0.1" material="table_mat"/>

    <!-- Solid Front Rebound Wall at +X = 2.0 m -->
    <geom name="front_wall" type="box" pos="2.0 0.0 0.10" size="0.10 2.0 0.10" material="wall_mat"/>

    <!-- 3-Link Planar Robot Arm (RRR) with End Effector Paddle -->
    <body name="robot_base" pos="-2.35 0.0 0.05">
      <geom name="base_geom" type="cylinder" size="0.12 0.05" material="base_mat" contype="0" conaffinity="0"/>

      <!-- Link 1 (Shoulder to Elbow) -->
      <body name="link1" pos="0.0 0.0 0.06">
        <joint name="joint1" type="hinge" axis="0 0 1" range="-2.8 2.8" limited="true" damping="0.01"/>
        <geom name="link1_geom" type="capsule" fromto="0 0 0 0.95 0 0" size="0.035" mass="10.0" material="arm1_mat" contype="0" conaffinity="0"/>

        <!-- Link 2 (Elbow to Wrist) -->
        <body name="link2" pos="0.95 0.0 0.04">
          <joint name="joint2" type="hinge" axis="0 0 1" range="-2.8 2.8" limited="true" damping="0.01"/>
          <geom name="link2_geom" type="capsule" fromto="0 0 0 0.85 0 0" size="0.030" mass="6.0" material="arm2_mat" contype="0" conaffinity="0"/>

          <!-- Link 3 / End Effector (Wrist + Paddle) -->
          <body name="paddle_link" pos="0.85 0.0 -0.11">
            <joint name="joint3" type="hinge" axis="0 0 1" range="-3.1415 3.1415" limited="true" damping="0.01"/>
            <!-- Paddle geom: length 0.60 m, width 0.10 m, height 0.08 m -->
            <geom name="paddle_geom" type="box" pos="0.18 0.0 0.0" size="0.05 0.30 0.04" mass="15.0" material="paddle_mat"/>
          </body>
        </body>
      </body>
    </body>

    <!-- Hockey Puck (3-DOF Planar: Slide X, Slide Y, Hinge Z) -->
    <body name="hockey_puck" pos="-0.5 0.0 0.015">
      <joint name="puck_x" type="slide" axis="1 0 0" damping="0.0"/>
      <joint name="puck_y" type="slide" axis="0 1 0" damping="0.0"/>
      <joint name="puck_rot" type="hinge" axis="0 0 1" damping="0.0"/>
      <geom name="puck_geom" type="cylinder" size="0.06 0.015" mass="0.17" material="puck_mat"/>
    </body>
  </worldbody>

  <!-- High-Torque / Velocity Actuators on Joints -->
  <actuator>
    <velocity name="actuator1" joint="joint1" kv="200" ctrlrange="-8.0 8.0"/>
    <velocity name="actuator2" joint="joint2" kv="150" ctrlrange="-8.0 8.0"/>
    <velocity name="actuator3" joint="joint3" kv="80" ctrlrange="-10.0 10.0"/>
  </actuator>
</mujoco>
